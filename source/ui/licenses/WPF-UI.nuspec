<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>WPF-UI</id>
    <version>4.3.0</version>
    <authors>lepo.co</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>Icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://github.com/lepoco/wpfui</projectUrl>
    <iconUrl>https://github.com/lepoco/wpfui/main/build/nuget.png</iconUrl>
    <description>WPF UI provides the Fluent experience in your known and loved WPF framework. Intuitive design, themes, navigation and new immersive controls. All natively and effortlessly.</description>
    <releaseNotes>https://github.com/lepoco/wpfui/releases</releaseNotes>
    <copyright>Copyright (C) 2021-2026 Leszek Pomianowski and WPF UI Contributors</copyright>
    <tags>ui wpf toolkit fluent navigation controls design icons uwp xaml xamarin theme winui mvvm mvc core web webview dotnet desktop wpf-ui .NET</tags>
    <repository type="git" url="https://github.com/lepoco/wpfui" branch="main" commit="153baadeaf475875a81a4605881ca5c2dbe53972" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="WPF-UI.Abstractions" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.6.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="WPF-UI.Abstractions" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETFramework4.8.1">
        <dependency id="WPF-UI.Abstractions" version="4.3.0" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0-windows7.0">
        <dependency id="WPF-UI.Abstractions" version="4.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net9.0-windows7.0">
        <dependency id="WPF-UI.Abstractions" version="4.3.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net10.0-windows7.0">
        <dependency id="WPF-UI.Abstractions" version="4.3.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net8.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework="net9.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework="net10.0-windows7.0">
        <frameworkReference name="Microsoft.WindowsDesktop.App.WPF" />
      </group>
      <group targetFramework=".NETFramework4.6.2" />
      <group targetFramework=".NETFramework4.7.2" />
      <group targetFramework=".NETFramework4.8.1" />
    </frameworkReferences>
  </metadata>
</package>